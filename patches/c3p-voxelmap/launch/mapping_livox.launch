<launch>
  <!-- Launch file for Livox (AVIA-style CustomMsg) LiDAR, e.g. Mid-360 -->

    <arg name="rviz" default="true" />

    <rosparam command="load" file="$(find c3p_voxelmap)/config/livox.yaml" />

    <node pkg="c3p_voxelmap" type="c3p_voxelmap" name="c3p_voxelmap" output="screen"/>
    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find c3p_voxelmap)/rviz_cfg/c3p_voxelmap.rviz" />
    </group>

</launch>
